Output assets/demo.gif
Set Shell "bash"
Set FontSize 18
Set Width 1320
Set Height 760
Set Padding 24
Set Theme "GitHub Dark"
Set Framerate 15
Set PlaybackSpeed 1
Set TypingSpeed 15ms
Hide
Type "node bin/gitclone-doctor.mjs --demo"
Enter
Sleep 4s
Show
Sleep 4s
Hide
Ctrl+L
Show
Type "node bin/gitclone-doctor.mjs --demo"
Enter
Sleep 8s
